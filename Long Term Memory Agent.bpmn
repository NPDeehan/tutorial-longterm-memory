<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="6fa43d2" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="LongTermMemory" name="Long Term Memory Agent Example" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="Final" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_1" name="Client Question">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="client-question-0yflk3s" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0o3mwoy</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0o3mwoy" sourceRef="StartEvent_1" targetRef="Activity_0srpldl" />
    <bpmn:adHocSubProcess id="Activity_0srpldl" name="Tech Agent" zeebe:modelerTemplate="Template_02ypy9o" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="{{secrets.AWS_REGION}}" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="us.anthropic.claude-sonnet-4-20250514-v1:0" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;You are **TaskAgent**, a helpful, incredibly up-beat agent who&#39;s always interested in the people you interact with. offering encouragment etc. you handel a wide variety of client requests using your own domain knowledge **and** any tools explicitly provided to you at runtime.&#10;&#10;Your goal is to take in a question from a client and use the tools provided to try to answer that user. The scope of the questions from the client are going to be about what the current stock of tech items are and how they can obtain get some and if they&#39;re entitled to them. &#10;&#10;The only way the user will see your response is by triggering the tools provided&#10;&#10;You must always prefer asking systems of record before you contact any humans. &#10;It&#39;s very likely that the client will have followup questions, you should continue to help them until they&#39;ve expressed that they are satisfied or if you feel you&#39;ve answered all of their questions&#10;&#10;Tools are provided, you should prefer them instead of guessing an answer. You can call the same tool multiple times by providing different input values. Don&#39;t guess any tools which were not explicitly configured. If no tool matches the request, try to generate an answer. If you&#39;re not able to find a good answer, return with a message stating why you&#39;re not able to.&#10;&#10;Wrap minimal, inspectable reasoning in *exactly* this template:&#10;&#10;--thinking--&#10;--context--…briefly state the customer’s need and current state…--context--&#10;--reflection--…list candidate tools, justify which you will call next and why… You should also suggest tools you intend to use later and why you need to delay the execution--reflection--&#10;--thinking--&#10;&#10;Reveal **no** additional private reasoning outside these tags.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=questionFromClient" target="data.userPrompt.prompt" />
          <zeebe:input target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=10" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0o3mwoy</bpmn:incoming>
      <bpmn:outgoing>Flow_09nw1ql</bpmn:outgoing>
      <bpmn:userTask id="Activity_1a744kr" name="Answer to Client">
        <bpmn:documentation>You can use this tool to answer the question posed by the client or to ask the client for clarification on their request. You can expect followup responses from the client to come back from this.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.answerForClient, &#34;This is the answer to the question posed by the client. format in markdown&#34;)" target="answerforClient" />
            <zeebe:output source="={&#10;  &#34;followupQuestion&#34; : followupQuestion&#10;}" target="toolCallResult" />
          </zeebe:ioMapping>
          <zeebe:formDefinition formId="answer-to-client-0audv21" />
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_0i8mode" name="Ask the Clerk">
        <bpmn:documentation>Use this tool to ask a human to answer any questions you have about the company or the products on offer.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="ask-question-to-human-1t7grmx" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.questionForClerk, &#34;This is the question for the human clerk to answer. format in markdown&#34;)" target="questionForClerk" />
            <zeebe:output source="={&#10;  &#34;answerToQuestion&#34; : humanAnswerToQuestion&#10;}" target="toolCallResult" />
            <zeebe:output source="=storeInMemory" target="storeInMemory" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_1pan8av</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:intermediateThrowEvent id="Event_0qhoybk">
        <bpmn:incoming>Flow_0rgsv4i</bpmn:incoming>
      </bpmn:intermediateThrowEvent>
      <bpmn:boundaryEvent id="Event_13nfdh6" attachedToRef="Activity_1ftg0az">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="={&#10;  &#34;searchResult&#34; :&#34;Nothing was found&#34;&#10;}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_0pwwn88" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_1pan8av" sourceRef="Activity_0i8mode" targetRef="Gateway_1htoy4p" />
      <bpmn:serviceTask id="Activity_0wyutvr" name="List of Tech stuff" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Use this tool to get a list of available tech stuff.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="https://api.restful-api.dev/objects" target="url" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="12" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultVariable" value="toolCallResult" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_0rgsv4i" name="No" sourceRef="Gateway_1htoy4p" targetRef="Event_0qhoybk">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(storeInMemory)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="Activity_1ftg0az" name="Query Company Information" zeebe:modelerTemplate="Template_148eei5" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Use this tool in order to get any information on policy or company or product specific questions you might have.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:embeddings-vector-database:1" retries="0" />
          <zeebe:ioMapping>
            <zeebe:input source="retrieveDocumentOperation" target="vectorDatabaseConnectorOperation.operationType" />
            <zeebe:input source="=fromAi(toolCall.query, &#34;This is the query you&#39;re making to the vector database&#34;)" target="vectorDatabaseConnectorOperation.query" />
            <zeebe:input source="=5" target="vectorDatabaseConnectorOperation.documentLimit" />
            <zeebe:input source="bedrockModelProvider" target="embeddingModelProvider.modelProvider" />
            <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="embeddingModelProvider.bedrock.accessKey" />
            <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="embeddingModelProvider.bedrock.secretKey" />
            <zeebe:input source="{{secrets.AWS_REGION}}" target="embeddingModelProvider.bedrock.region" />
            <zeebe:input source="TitanEmbedTextV2" target="embeddingModelProvider.bedrock.modelName" />
            <zeebe:input source="D1024" target="embeddingModelProvider.bedrock.dimensions" />
            <zeebe:input source="=false" target="embeddingModelProvider.bedrock.normalize" />
            <zeebe:input source="=3" target="embeddingModelProvider.bedrock.maxRetries" />
            <zeebe:input source="amazonManagedOpenSearchStore" target="vectorStore.storeType" />
            <zeebe:input source="{{secrets.AWS_VECTOR_ACCESS}}" target="vectorStore.amazonManagedOpensearch.accessKey" />
            <zeebe:input source="{{secrets.AWS_VECTOR_SECRET}}" target="vectorStore.amazonManagedOpensearch.secretKey" />
            <zeebe:input source="{{secrets.AWS_LONGTERM_MEM}}" target="vectorStore.amazonManagedOpensearch.serverUrl" />
            <zeebe:input source="{{secrets.AWS_REGION}}" target="vectorStore.amazonManagedOpensearch.region" />
            <zeebe:input source="=&#34;tech-stuff-knowagebase&#34;" target="vectorStore.amazonManagedOpensearch.indexName" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="2" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.EmbeddingsVectorDB.v1" />
            <zeebe:header key="resultVariable" value="toolCallResult" />
            <zeebe:header key="errorExpression" value="=if contains(error.message, &#34;index_not_found&#34;) then bpmnError(&#34;index_not_found&#34;, &#34;The index does not exist&#34;) else null" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_1htoy4p" name="Store in memory">
        <bpmn:incoming>Flow_1pan8av</bpmn:incoming>
        <bpmn:outgoing>Flow_1d4blt1</bpmn:outgoing>
        <bpmn:outgoing>Flow_0rgsv4i</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_1d4blt1" name="Yes" sourceRef="Gateway_1htoy4p" targetRef="Activity_1kck85z">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=storeInMemory</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="Activity_1kck85z" name="Store Company Information" zeebe:modelerTemplate="Template_144nwad" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:embeddings-vector-database:1" retries="0" />
          <zeebe:ioMapping>
            <zeebe:input source="embedDocumentOperation" target="vectorDatabaseConnectorOperation.operationType" />
            <zeebe:input source="bedrockModelProvider" target="embeddingModelProvider.modelProvider" />
            <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="embeddingModelProvider.bedrock.accessKey" />
            <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="embeddingModelProvider.bedrock.secretKey" />
            <zeebe:input source="{{secrets.AWS_REGION}}" target="embeddingModelProvider.bedrock.region" />
            <zeebe:input source="TitanEmbedTextV2" target="embeddingModelProvider.bedrock.modelName" />
            <zeebe:input source="D1024" target="embeddingModelProvider.bedrock.dimensions" />
            <zeebe:input source="=false" target="embeddingModelProvider.bedrock.normalize" />
            <zeebe:input source="=3" target="embeddingModelProvider.bedrock.maxRetries" />
            <zeebe:input source="amazonManagedOpenSearchStore" target="vectorStore.storeType" />
            <zeebe:input source="{{secrets.AWS_VECTOR_ACCESS}}" target="vectorStore.amazonManagedOpensearch.accessKey" />
            <zeebe:input source="{{secrets.AWS_VECTOR_SECRET}}" target="vectorStore.amazonManagedOpensearch.secretKey" />
            <zeebe:input source="{{secrets.AWS_LONGTERM_MEM}}" target="vectorStore.amazonManagedOpensearch.serverUrl" />
            <zeebe:input source="{{secrets.AWS_REGION}}" target="vectorStore.amazonManagedOpensearch.region" />
            <zeebe:input source="=&#34;tech-stuff-knowagebase&#34;" target="vectorStore.amazonManagedOpensearch.indexName" />
            <zeebe:input source="PlainText" target="vectorDatabaseConnectorOperation.documentSource" />
            <zeebe:input source="=toolCallResult.answerToQuestion" target="vectorDatabaseConnectorOperation.documentSourceFromProcessVariable" />
            <zeebe:input source="recursiveDocumentSplitter" target="vectorDatabaseConnectorOperation.documentSplitter.splitterType" />
            <zeebe:input source="=500" target="vectorDatabaseConnectorOperation.documentSplitter.maxSegmentSizeInChars" />
            <zeebe:input source="=80" target="vectorDatabaseConnectorOperation.documentSplitter.maxOverlapSizeInChars" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="2" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.EmbeddingsVectorDB.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1d4blt1</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Activity_0ij0dfm" name="Query for Agent Procedure" zeebe:modelerTemplate="Template_148eei5" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Use this tool to search the knowage base for information on how this kind of request was solved in the past to ensure your solution learns form past successes.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:embeddings-vector-database:1" retries="0" />
          <zeebe:ioMapping>
            <zeebe:input source="retrieveDocumentOperation" target="vectorDatabaseConnectorOperation.operationType" />
            <zeebe:input source="=fromAi(toolCall.query, &#34;The knowledge base query you want to perform&#34;)" target="vectorDatabaseConnectorOperation.query" />
            <zeebe:input source="=5" target="vectorDatabaseConnectorOperation.documentLimit" />
            <zeebe:input source="bedrockModelProvider" target="embeddingModelProvider.modelProvider" />
            <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="embeddingModelProvider.bedrock.accessKey" />
            <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="embeddingModelProvider.bedrock.secretKey" />
            <zeebe:input source="{{secrets.AWS_REGION}}" target="embeddingModelProvider.bedrock.region" />
            <zeebe:input source="TitanEmbedTextV2" target="embeddingModelProvider.bedrock.modelName" />
            <zeebe:input source="D1024" target="embeddingModelProvider.bedrock.dimensions" />
            <zeebe:input source="=false" target="embeddingModelProvider.bedrock.normalize" />
            <zeebe:input source="=3" target="embeddingModelProvider.bedrock.maxRetries" />
            <zeebe:input source="amazonManagedOpenSearchStore" target="vectorStore.storeType" />
            <zeebe:input source="{{secrets.AWS_VECTOR_ACCESS}}" target="vectorStore.amazonManagedOpensearch.accessKey" />
            <zeebe:input source="{{secrets.AWS_VECTOR_SECRET}}" target="vectorStore.amazonManagedOpensearch.secretKey" />
            <zeebe:input source="{{secrets.AWS_LONGTERM_MEM}}" target="vectorStore.amazonManagedOpensearch.serverUrl" />
            <zeebe:input source="{{secrets.AWS_REGION}}" target="vectorStore.amazonManagedOpensearch.region" />
            <zeebe:input source="=&#34;techAgent-past-execution-knowagebase&#34;" target="vectorStore.amazonManagedOpensearch.indexName" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="2" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.EmbeddingsVectorDB.v1" />
            <zeebe:header key="resultVariable" value="toolCallResult" />
            <zeebe:header key="errorExpression" value="=if contains(error.message, &#34;index_not_found&#34;) then bpmnError(&#34;index_not_found&#34;, &#34;The index does not exist&#34;) else null" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="Event_0qimdom" attachedToRef="Activity_0ij0dfm">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="={&#10;  &#34;QueryResult&#34; : &#34;No Data found for this query&#34;&#10;}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_0fq7hez" />
      </bpmn:boundaryEvent>
    </bpmn:adHocSubProcess>
    <bpmn:serviceTask id="Activity_061pzwo" name="Agent as a Judge" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:1" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="us-east-1" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="us.anthropic.claude-sonnet-4-5-20250929-v1:0" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;You are Agent Performance Evaluator for An Insurance company’s AI Support agaent.&#10;Your single task:&#10;&#10;&#10;After reading the customer agent exchange in the prompt, decide whether the agent’s handling was optimal, sub-optimal, or not acceptable.&#10;&#10;Then create a detailed summary for a user to read that explains your findings under the following evaluation critera&#10;&#10;Domain-Scope Compliance&#10;Tool-Usage audit of Effectiveness (for each tool give a short assessment)&#10;&#10;Chain-of-Thought Quality &#10;Satisfaction Confirmation &#38; Resolution&#10;Regulatory &#38; Privacy Compliance&#10;&#10;Your output should be formated in markdown&#10;&#10;&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=string(agentExectionDetails)" target="data.userPrompt.prompt" />
          <zeebe:input source="=llmjudge.context" target="data.context" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=10" target="data.limits.maxModelCalls" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=true" target="data.response.includeAssistantMessage" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.v1" />
          <zeebe:header key="resultVariable" value="llmjudge" />
          <zeebe:header key="resultExpression" value="={&#10;  &#34;complete_summary&#34; : responseText&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ddwyat</bpmn:incoming>
      <bpmn:outgoing>Flow_0wpwk5z</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1i0498h">
      <bpmn:incoming>Flow_1td07ji</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0rpqynl" default="Flow_1td07ji">
      <bpmn:incoming>Flow_1huapps</bpmn:incoming>
      <bpmn:outgoing>Flow_1td07ji</bpmn:outgoing>
      <bpmn:outgoing>Flow_0i3bstk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_061jpn8" name="Process Complete">
      <bpmn:incoming>Flow_0ivw7px</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_0qakv13" name="Review case resolution">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-case-resolution-skadfa" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0wpwk5z</bpmn:incoming>
      <bpmn:outgoing>Flow_1huapps</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_031aptj" name="Save Agent Procedure" zeebe:modelerTemplate="Template_144nwad" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:embeddings-vector-database:1" retries="0" />
        <zeebe:ioMapping>
          <zeebe:input source="embedDocumentOperation" target="vectorDatabaseConnectorOperation.operationType" />
          <zeebe:input source="bedrockModelProvider" target="embeddingModelProvider.modelProvider" />
          <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="embeddingModelProvider.bedrock.accessKey" />
          <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="embeddingModelProvider.bedrock.secretKey" />
          <zeebe:input source="{{secrets.AWS_REGION}}" target="embeddingModelProvider.bedrock.region" />
          <zeebe:input source="TitanEmbedTextV2" target="embeddingModelProvider.bedrock.modelName" />
          <zeebe:input source="D1024" target="embeddingModelProvider.bedrock.dimensions" />
